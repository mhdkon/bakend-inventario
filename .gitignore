# ============================================================
# BACKEND — .gitignore
# ============================================================

# Dependencias
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Variables de entorno (NUNCA subir al repo)
.env
.env.local
.env.*.local
.env.production
.env.development

# Pero sí queremos el ejemplo
!.env.example

# Archivos subidos temporalmente (CSV, imágenes)
uploads/
tmp/
temp/

# Backups locales
*.dump
*.sql.gz
backups/

# Logs
logs/
*.log

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
.idea/
*.swp
*.swo
*~

# Builds (si compilas el backend a dist/)
dist/
build/

# Coverage y tests
coverage/
.nyc_output/

# PM2
.pm2/
pm2.log*

# Docker (si lo usas)
*.pid
*.seed
*.pid.lock